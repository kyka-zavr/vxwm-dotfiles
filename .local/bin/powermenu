#!/usr/bin/env python3
"""powermenu — clickable icon powermenu, centered on screen over everything."""
import json
import os
import shutil
import signal
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk  # noqa: E402

PIDFILE = "/tmp/powermenu.pid"


def running_pid():
    if not os.path.exists(PIDFILE):
        return None
    try:
        pid = int(open(PIDFILE).read().strip())
        os.kill(pid, 0)
        return pid
    except (ValueError, ProcessLookupError, PermissionError):
        return None


existing = running_pid()
if existing:
    # already open — firing the keybind again just closes it
    os.kill(existing, signal.SIGTERM)
    sys.exit(0)

with open(PIDFILE, "w") as f:
    f.write(str(os.getpid()))


def cleanup(*_a):
    try:
        os.remove(PIDFILE)
    except OSError:
        pass
    Gtk.main_quit()


colors_path = os.path.expanduser("~/.cache/wal/colors.json")
try:
    pal = json.load(open(colors_path))
    bg = pal["special"]["background"]
    fg = pal["special"]["foreground"]
    accent = pal["colors"]["color4"]
    hover = pal["colors"]["color8"]
except Exception:
    bg, fg, accent, hover = "#0b0404", "#c2c0c0", "#88c0d0", "#333333"

CSS = f"""
window {{
    background-color: {bg};
}}
button {{
    background-image: none;
    background-color: transparent;
    border: none;
    box-shadow: none;
    color: {fg};
    padding: 16px 20px;
    border-radius: 10px;
}}
button:hover, button:focus {{
    background-color: {hover};
}}
label.pm-icon {{
    font-family: "JetBrainsMono Nerd Font Mono";
    font-size: 24pt;
    color: {accent};
}}
label.pm-label {{
    font-family: "Adwaita Sans";
    font-size: 9pt;
    color: {fg};
}}
""".encode()

provider = Gtk.CssProvider()
provider.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
)


def run(cmd):
    subprocess.Popen(cmd)


def do_lock(_b):
    cleanup()
    if shutil.which("betterlockscreen"):
        run(["betterlockscreen", "-l", "blur"])
    else:
        run(["xset", "dpms", "force", "off"])


def do_exit(_b):
    cleanup()
    run(["killall", "vxwm"])


def do_suspend(_b):
    cleanup()
    run(["systemctl", "suspend"])


def do_reboot(_b):
    cleanup()
    run(["systemctl", "reboot"])


def do_poweroff(_b):
    cleanup()
    run(["systemctl", "poweroff"])


ITEMS = [
    (chr(0xF023), "Lock", do_lock),
    (chr(0xF08B), "Exit", do_exit),
    (chr(0xF186), "Suspend", do_suspend),
    (chr(0xF021), "Reboot", do_reboot),
    (chr(0xF011), "Poweroff", do_poweroff),
]

win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
win.set_title("Powermenu")  # matched by picom + vxwm float rules
win.set_decorated(False)
win.set_skip_taskbar_hint(True)
win.set_skip_pager_hint(True)
win.set_resizable(False)
win.set_keep_above(True)

box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
box.set_margin_top(14)
box.set_margin_bottom(14)
box.set_margin_start(14)
box.set_margin_end(14)
win.add(box)

for glyph, label, handler in ITEMS:
    btn = Gtk.Button()
    btn.set_relief(Gtk.ReliefStyle.NONE)
    vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    icon = Gtk.Label(label=glyph)
    icon.get_style_context().add_class("pm-icon")
    cap = Gtk.Label(label=label)
    cap.get_style_context().add_class("pm-label")
    vb.pack_start(icon, False, False, 0)
    vb.pack_start(cap, False, False, 0)
    btn.add(vb)
    btn.connect("clicked", handler)
    box.pack_start(btn, False, False, 0)

win.connect("destroy", cleanup)
win.connect(
    "key-press-event",
    lambda w, e: cleanup() if e.keyval == Gdk.KEY_Escape else None,
)

win.show_all()
win.realize()

screen_w = Gdk.Screen.width()
screen_h = Gdk.Screen.height()
win_w, win_h = win.get_size()
win.move((screen_w - win_w) // 2, (screen_h - win_h) // 2)

signal.signal(signal.SIGTERM, lambda *_a: cleanup())
Gtk.main()
