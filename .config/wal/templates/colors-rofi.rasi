/* generated by pywal — rofi colors for config.rasi (simple-tokyonight layout) */
* {
  bg0     : {background}E6;
  bg1     : {background}E6;
  bg2     : {color8}E6;
  bg3     : {color8};
  fg0     : {foreground};
  fg1     : {foreground};
  fg2     : {color8};
  red     : {color1};
  green   : {color2};
  yellow  : {color3};
  blue    : {color4};
  magenta : {color5};
  cyan    : {color6};

  accent: @blue;
  urgent: @yellow;
}
