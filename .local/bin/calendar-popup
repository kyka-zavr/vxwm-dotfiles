#!/usr/bin/env python3
"""calendar-popup — small themed calendar, toggled by clicking the date in the bar."""
import json
import os
import signal
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk  # noqa: E402

PIDFILE = "/tmp/calendar-popup.pid"


def running_pid():
    if not os.path.exists(PIDFILE):
        return None
    try:
        pid = int(open(PIDFILE).read().strip())
        os.kill(pid, 0)
        return pid
    except (ValueError, ProcessLookupError, PermissionError):
        return None


existing = running_pid()
if existing:
    # already open — clicking the date again just closes it
    os.kill(existing, signal.SIGTERM)
    sys.exit(0)

with open(PIDFILE, "w") as f:
    f.write(str(os.getpid()))


def cleanup(*_a):
    try:
        os.remove(PIDFILE)
    except OSError:
        pass
    Gtk.main_quit()


colors_path = os.path.expanduser("~/.cache/wal/colors.json")
try:
    pal = json.load(open(colors_path))
    bg = pal["special"]["background"]
    fg = pal["special"]["foreground"]
    accent = pal["colors"]["color4"]
except Exception:
    bg, fg, accent = "#0b0404", "#c2c0c0", "#88c0d0"

CSS = f"""
window {{
    background-color: {bg};
}}
calendar {{
    background-color: {bg};
    color: {fg};
    font-family: "Adwaita Sans";
    font-size: 11pt;
    border: none;
    padding: 12px;
}}
calendar:selected {{
    background-color: {accent};
    color: {bg};
    border-radius: 6px;
}}
calendar.header {{
    background-color: {bg};
    color: {fg};
    font-weight: bold;
}}
calendar.button, calendar.button:hover {{
    background: transparent;
    color: {fg};
    border: none;
}}
""".encode()

provider = Gtk.CssProvider()
provider.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
)

win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
win.set_title("Calendar")  # matched by name in picom + vxwm float/animation rules
win.set_decorated(False)
win.set_skip_taskbar_hint(True)
win.set_skip_pager_hint(True)
win.set_resizable(False)
win.set_keep_above(True)

cal = Gtk.Calendar()
win.add(cal)

win.connect("destroy", cleanup)
# close-on-focus-loss was unreliable under vxwm (some background event kept
# closing it a few seconds after open, not tied to actually clicking away) —
# dropped in favor of click-date-again / Escape, which are unambiguous.
win.connect(
    "key-press-event",
    lambda w, e: cleanup() if e.keyval == Gdk.KEY_Escape else None,
)

win.show_all()
win.realize()

screen_w = Gdk.Screen.width()
win_w, win_h = win.get_size()
win.move((screen_w - win_w) // 2, 40)

signal.signal(signal.SIGTERM, lambda *_a: cleanup())
Gtk.main()
